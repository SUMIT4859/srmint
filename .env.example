# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# Your Telegram User ID (obtained from @userinfobot). If 0, the first user to /start will be set as admin.
TELEGRAM_ADMIN_ID=0

# EVM Chain RPC Endpoint (Robinhood, Ink, Ethereum, Soneium, Elysium)
RPC_URL=https://rpc.mainnet.chain.robinhood.com
FALLBACK_RPC_URL=https://rpc.mainnet.chain.robinhood.com
INK_RPC_URL=https://rpc-gel.inkonchain.com
INK_FALLBACK_RPC_URL=https://rpc-qnd.inkonchain.com
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
ETH_FALLBACK_RPC_URL=https://1rpc.io/eth
SONEIUM_RPC_URL=https://rpc.soneium.org
SONEIUM_FALLBACK_RPC_URL=https://rpc.nodeflare.app/soneium/public
ELYSIUM_RPC_URL=https://rpc.elysium.kinetiq.xyz
ELYSIUM_FALLBACK_RPC_URL=https://rpc-live.elysp.com

# Gas & Fee Configuration
GAS_LIMIT=300000
FEE_MULTIPLIER=1.25
SCHEDULED_FEE_MULTIPLIER=2.0
MAX_PRIORITY_FEE_GWEI=1.5

# Lead broadcast time in milliseconds before phase opening (e.g., 80ms)
BROADCAST_LEAD_MS=80

# Wallets JSON Manifest Path
WALLETS_FILE=wallets.json

